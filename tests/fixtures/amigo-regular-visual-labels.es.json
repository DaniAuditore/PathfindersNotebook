    { "sourceCode": "amigo.reg.s01.r01", "displayText": "Tener como mínimo 10 años de edad." },
    { "sourceCode": "amigo.reg.s01.r02", "displayText": "Ser miembro activo del club de Conquistadores." },
    { "sourceCode": "amigo.reg.s01.r03", "displayText": "Memorizar y explicar el Voto y la Ley del Conquistador." },
    { "sourceCode": "amigo.reg.s01.r04", "displayText": "Leer el libro del club de Lectura Juvenil del año en curso." },
    { "sourceCode": "amigo.reg.s01.r05", "displayText": "Leer el libro Vaso de Barro." },
    { "sourceCode": "amigo.reg.s01.r06", "displayText": "Participar activamente de la Clase Bíblica de su club." },
    { "sourceCode": "amigo.reg.s02.r01", "displayText": "Memorizar y demostrar su conocimiento en:" },
    { "sourceCode": "amigo.reg.s02.r01.c01", "displayText": "Creación: Lo que Dios creó en cada día de la creación." },
    { "sourceCode": "amigo.reg.s02.r01.c02", "displayText": "10 Plagas: Qué plagas cayeron sobre Egipto." },
    { "sourceCode": "amigo.reg.s02.r01.c03", "displayText": "12 Tribus: El Nombre de cada una de las tribus de Israel." },
    { "sourceCode": "amigo.reg.s02.r01.c04", "displayText": "39 libros del antiguo testamento y demostrar habilidad para encontrar cualquiera de ellos." },
    { "sourceCode": "amigo.reg.s02.r02", "displayText": "Leer y explicar los siguientes versículos:" },
