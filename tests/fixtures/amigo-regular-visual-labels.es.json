    { "sourceCode": "amigo.reg.s03.r01", "displayText": "Dedicar dos horas ayudando a alguien en su comunidad, a través de dos de las siguientes actividades:" },
    { "sourceCode": "amigo.reg.s03.r01.c01", "displayText": "Visitar a alguien que necesita de amistad y orar con esa persona." },
    { "sourceCode": "amigo.reg.s03.r01.c02", "displayText": "Ofrecer y llevar alimento a alguien carente." },
    { "sourceCode": "amigo.reg.s03.r01.c03", "displayText": "Participar de un proyecto ecológico o educativo." },
    { "sourceCode": "amigo.reg.s03.r02", "displayText": "Escribir una redacción de cómo ser un buen ciudadano en el hogar y en la escuela (hoja tamaño carta, letra Arial 12)" },
    { "sourceCode": "amigo.reg.s04.r01", "displayText": "Mencionar diez cualidades de un buen amigo y presentar cuatro situaciones diarias en las que usted practicó la Regla de Oro de Mateo 7:12." },
    { "sourceCode": "amigo.reg.s04.r02", "displayText": "Saber cantar el Himno Nacional de su país y conocer su historia. Saber el nombre del autor de la letra y de la música del himno." },
    { "sourceCode": "amigo.reg.s05.r01", "displayText": "Completar una de las siguientes especialidades:" },
    { "sourceCode": "amigo.reg.s05.r01.c01", "displayText": "Natación I" },
    { "sourceCode": "amigo.reg.s05.r01.c02", "displayText": "Aptitud física" },
    { "sourceCode": "amigo.reg.s05.r01.c03", "displayText": "Nudos y amarras" },
    { "sourceCode": "amigo.reg.s05.r01.c04", "displayText": "Seguridad básica en el agua" },
    { "sourceCode": "amigo.reg.s05.r02", "displayText": "Utilizando la experiencia de Daniel:" },
    { "sourceCode": "amigo.reg.s05.r02.c01", "displayText": "Explicar los principios de temperancia que él defendió, o participar de una presentación o escenificación de Daniel" },
    { "sourceCode": "amigo.reg.s05.r02.c02", "displayText": "Memorizar y explicar Daniel 1:8." },
    { "sourceCode": "amigo.reg.s05.r02.c03", "displayText": "Escribir su compromiso personal de seguir un estilo de vida saludable." },
    { "sourceCode": "amigo.reg.s05.r03", "displayText": "Aprender los principios de una dieta saludable y ayudar a preparar un cuadro con los grupos básicos de alimentos." },
    { "sourceCode": "amigo.reg.s06.r01", "displayText": "Através de la observación, acompañar todo el proceso de planeamiento hasta la ejecución de una caminata de 5 kilómetros." },
    { "sourceCode": "amigo.reg.s07.r01", "displayText": "Completar una de las siguientes especialidades:" },
    { "sourceCode": "amigo.reg.s07.r01.c01", "displayText": "Felinos" },
    { "sourceCode": "amigo.reg.s07.r01.c02", "displayText": "Perros" },
    { "sourceCode": "amigo.reg.s07.r01.c03", "displayText": "Mamíferos" },
    { "sourceCode": "amigo.reg.s07.r01.c04", "displayText": "Semillas" },
    { "sourceCode": "amigo.reg.s07.r01.c05", "displayText": "Aves domésticas" },
    { "sourceCode": "amigo.reg.s07.r02", "displayText": "Aprender y demostrar una forma para purificar el agua y escribir un párrafo destacando el significado de Jesús como el agua de Vida." },
    { "sourceCode": "amigo.reg.s07.r03", "displayText": "Aprender y armar tres tipos diferentes de carpas en lugares apropiados." },
    { "sourceCode": "amigo.reg.s08.r01", "displayText": "Demostrar cómo cuidar correctamente de una cuerda. Hacer y explicar el uso práctico de los siguientes nudos:" },
    { "sourceCode": "amigo.reg.s08.r01.c01", "displayText": "Simple o Cote" },
    { "sourceCode": "amigo.reg.s08.r01.c02", "displayText": "Falso" },
    { "sourceCode": "amigo.reg.s08.r01.c03", "displayText": "Verdadero o Llano" },
    { "sourceCode": "amigo.reg.s08.r01.c04", "displayText": "Cirujano" },
    { "sourceCode": "amigo.reg.s08.r01.c05", "displayText": "As de guía" },
    { "sourceCode": "amigo.reg.s08.r01.c06", "displayText": "As de guía doble" },
    { "sourceCode": "amigo.reg.s08.r01.c07", "displayText": "Escota" },
    { "sourceCode": "amigo.reg.s08.r01.c08", "displayText": "Margarita" },
    { "sourceCode": "amigo.reg.s08.r01.c09", "displayText": "Pescador" },
    { "sourceCode": "amigo.reg.s08.r01.c10", "displayText": "Ancia" },
    { "sourceCode": "amigo.reg.s08.r01.c11", "displayText": "Ballestrinque" },
    { "sourceCode": "amigo.reg.s08.r01.c12", "displayText": "Vuelta de gancho" },
    { "sourceCode": "amigo.reg.s08.r01.c13", "displayText": "Leñador" },
    { "sourceCode": "amigo.reg.s08.r01.c14", "displayText": "Calabrote" },
    { "sourceCode": "amigo.reg.s08.r02", "displayText": "Completar la especialidad de Arte de acampar I" },
    { "sourceCode": "amigo.reg.s08.r03", "displayText": "Presentar en forma escrita 10 reglas para una caminata y explicar qué hacer en caso que esté perdido." },
    { "sourceCode": "amigo.reg.s08.r04", "displayText": "Aprender las señales para seguir una pista. Preparar y seguir una pista con un mínimo de 10 señales que también pueda ser seguida por otros." },
    { "sourceCode": "amigo.reg.s09.r01", "displayText": "Completar una especialidad en el área de Artes y Habilidades Manuales." }
